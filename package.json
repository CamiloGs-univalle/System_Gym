{
    "name": "system_gym",
    "version": "2.0.0",
    "private": true,
    "description": "System Gym - Sistema de gestión de gimnasios",
    "author": "Camilo Garcia",
    "main": "electron/main.js",
    "scripts": {
        "dev": "concurrently \"npm run vite\" \"npm run electron\"",
        "vite": "vite",
        "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
        "build": "vite build",
        "dist": "npm run build && electron-builder",
        "preparar-jre": "powershell -ExecutionPolicy Bypass -File scripts/preparar-jre.ps1"
    },
    "build": {
        "appId": "com.systemgym.app",
        "productName": "System Gym",
        "files": [
            "**/*",
            "!panel-web/**",
            "!_descartado/**",
            "!src/**",
            "!Doc/**",
            "!tools/**",
            "!scripts/**",
            "!jre/**",
            "!release/**"
        ],
        "directories": {
            "output": "release"
        },
        "extraResources": [
            {
                "from": "../backendGym/target/quarkus-app/",
                "to": "backend/"
            },
            {
                "from": "jre",
                "to": "jre",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis"
        }
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "electron": "^42.4.1",
        "electron-builder": "^26.15.3",
        "vite": "^8.0.16",
        "wait-on": "^9.0.10"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
        "axios": "^1.18.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.468.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.0",
        "xlsx": "^0.18.5",
        "zustand": "^5.0.14"
    }
}
