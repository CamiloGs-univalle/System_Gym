# ============================================================
# Panel web de System Gym - variables de entorno
# ============================================================

# Código que el PC del gimnasio usa para enviar los datos (mínimo 16 caracteres).
# Genere uno con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Es el mismo que se pega en System Gym -> Configuración -> Panel web.
SYNC_TOKEN=

# Usuario y contraseña del administrador para entrar desde el celular (contraseña mínimo 10 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Firma de las sesiones (mínimo 32 caracteres). Si se deja vacío, las sesiones se cierran al reiniciar.
SESSION_SECRET=

# PostgreSQL (recomendado en Render/Railway, cuyo disco se borra en cada despliegue).
# Si se deja vacío, los datos se guardan en DATA_DIR.
DATABASE_URL=
DATA_DIR=./data

# Opcionales
# PORT=3000
# SESSION_DAYS=7
# PANEL_TZ=America/Bogota
